FROM ubuntu:24.04

ARG BUN_VERSION=1.3.14
ARG UV_VERSION=0.11.17

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        libatomic1 \
        libicu-dev \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && case "$(dpkg --print-architecture)" in amd64) bun_arch=x64 ;; arm64) bun_arch=aarch64 ;; *) exit 1 ;; esac \
    && curl -fsSL -o /tmp/bun.zip "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${bun_arch}.zip" \
    && unzip -q /tmp/bun.zip -d /tmp/bun \
    && install -m 755 "/tmp/bun/bun-linux-${bun_arch}/bun" /usr/local/bin/bun \
    && ln -s /usr/local/bin/bun /usr/local/bin/bunx \
    && rm -rf /tmp/bun /tmp/bun.zip \
    && curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | env UV_INSTALL_DIR=/usr/local/bin sh

ENV CI=1
WORKDIR /workspace/10018-GPP-Engiware/opencode
