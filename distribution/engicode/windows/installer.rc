#include <windows.h>
#include "resource-version.h"

1 ICON "installer.ico"
1 RT_MANIFEST "installer.manifest"

1 VERSIONINFO
FILEVERSION ENGICODE_VERSION_NUMBER
PRODUCTVERSION ENGICODE_VERSION_NUMBER
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Green Pipe Partners\0"
      VALUE "FileDescription", "EngiCode Setup\0"
      VALUE "FileVersion", ENGICODE_VERSION_TEXT "\0"
      VALUE "InternalName", "EngiCodeSetup\0"
      VALUE "LegalCopyright", "Copyright Green Pipe Partners\0"
      VALUE "OriginalFilename", "EngiCodeSetup.exe\0"
      VALUE "ProductName", "EngiCode\0"
      VALUE "ProductVersion", ENGICODE_VERSION_TEXT "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
